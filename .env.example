# AccessRoute Environment Configuration Example
# Copy this file to .env and fill in your actual API keys

# Google Maps Platform API Key (Requires JavaScript API, Directions API, Places API)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Gemini API Key for AI Photo Barrier Vision Analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Express Server Port (Default: 3001)
PORT=3001

